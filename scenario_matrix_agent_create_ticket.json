{
  "flow": "agent_create_ticket",
  "inventory_text": "A1. customer | ui_label: Organization | type: select | required: yes | constraints: none | auto_filled: no\nA2. user | ui_label: Organization User | type: select | required: yes | constraints: none | auto_filled: no\nA3. equipment | ui_label: Provision Equipment | type: select | required: no | constraints: none | auto_filled: no\nA4. service_type | ui_label: Service Type | type: select | required: yes | constraints: none | auto_filled: yes\nA5. department | ui_label: Department | type: select | required: yes | constraints: none | auto_filled: yes\nA6. staff_accountable | ui_label: Accountable | type: select | required: no | constraints: none | auto_filled: yes\nA7. staff_assigned | ui_label: Assignee | type: select | required: no | constraints: none | auto_filled: yes\nA8. priority | ui_label: Priority | type: select | required: yes | constraints: none | auto_filled: yes\nA9. due_date | ui_label: Due Date | type: date | required: yes | constraints: none | auto_filled: yes\nA10. subject | ui_label: Subject | type: text | required: yes | constraints: maxLength 175 | auto_filled: no\nA11. description | ui_label: Description | type: textarea | required: no | constraints: none | auto_filled: no\nA12. files | ui_label: Attachment | type: file | required: no | constraints: Allowed file types: Image, PDF, Word, Excel, CSV, Eml, Easm, Mp4, Mov | auto_filled: no\n\nB1. customer -> user | EFFECT: filter | GUARD: none | REVERSAL: reset user\nB2. customer -> equipment | EFFECT: filter | GUARD: none | REVERSAL: reset equipment\nB3. service_type -> department | EFFECT: filter | GUARD: none | REVERSAL: reset department\nB4. department -> staff_accountable | EFFECT: auto-fill | GUARD: none | REVERSAL: reset staff_accountable\nB5. department -> staff_assigned | EFFECT: filter | GUARD: none | REVERSAL: reset staff_assigned\nB6. department -> due_date | EFFECT: auto-fill | GUARD: none | REVERSAL: reset due_date\nB7. service_type + priority + customer -> due_date | EFFECT: calculate | GUARD: none | REVERSAL: reset due_date\n\n\nD1. agent CAN see the record | WHEN: staff_assigned=agent\nD2. agent CAN see the record | WHEN: staff_accountable=agent\nD3. agent CAN see the record | WHEN: created_by_staff_id=agent\nD4. agent CAN see the record | WHEN: department has ticket.view permission AND agent is manager/admin\n\nE1. FIELD: customer | SOURCE: known_entities.customers | DISPLAY LABEL: name\nE2. FIELD: user | SOURCE: known_entities.customers.users | DISPLAY LABEL: name | SCOPE: current_user_org\nE3. FIELD: equipment | SOURCE: known_entities.customers.equipment | DISPLAY LABEL: provision_name | SCOPE: current_user_org\nE4. FIELD: service_type | SOURCE: known_entities.departments.service_types | DISPLAY LABEL: name\nE5. FIELD: department | SOURCE: known_entities.departments | DISPLAY LABEL: name\nE6. FIELD: staff_accountable | SOURCE: known_entities.departments.staff | DISPLAY LABEL: name\nE7. FIELD: staff_assigned | SOURCE: known_entities.departments.staff | DISPLAY LABEL: name\nE8. FIELD: priority | SOURCE: static | DISPLAY LABEL: label",
