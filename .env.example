OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=16000
OPENAI_MODEL_PROMPT_COST=
OPENAI_MODEL_COMPLETION_COST=
TEST_AGENT_EMAIL=your_test_agent_email_here
GENERATE2_BATCH_SIZE=20

# record.py / execute.py
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
PLAYWRIGHT_TIMEOUT_MS=10000
# Prefix injected into every SR name during test runs so created records are
# identifiable and can be bulk-deleted after. Set to empty string to disable.
TEST_CLEANUP_PREFIX=[TEST]

# One EMAIL + PASSWORD pair per role in the app.
# Key format: TEST_{ROLE}_EMAIL / TEST_{ROLE}_PASSWORD
# Role name → key prefix: upper-case, non-alphanumerics become underscores.
#   "any_authorized_role"                    → AGENT  (fallback default)
#   "Service Manager"                        → SERVICE_MANAGER
#   "Service Engineer"                       → SERVICE_ENGINEER
#   "Admin"                                  → ADMIN
#   "Customer User"                          → CUSTOMER_USER

TEST_AGENT_EMAIL=
TEST_AGENT_PASSWORD=

TEST_SERVICE_MANAGER_EMAIL=
TEST_SERVICE_MANAGER_PASSWORD=

TEST_SERVICE_ENGINEER_EMAIL=
TEST_SERVICE_ENGINEER_PASSWORD=

# Must be an SE account whose permissions table entry has service_report.create=false
# in every department — used for permission-denial cases. If TEST_SERVICE_ENGINEER
# above happens to have create permission somewhere, add a second account here for
# cases that need one that CAN create a report:
TEST_SERVICE_ENGINEER_WITH_PERMISSION_EMAIL=
TEST_SERVICE_ENGINEER_WITH_PERMISSION_PASSWORD=

TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

TEST_CUSTOMER_USER_EMAIL=
TEST_CUSTOMER_USER_PASSWORD=
