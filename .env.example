OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=16000
OPENAI_MODEL_PROMPT_COST=
OPENAI_MODEL_COMPLETION_COST=
GENERATE2_BATCH_SIZE=20

# record.py / execute.py
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
PLAYWRIGHT_TIMEOUT_MS=10000

# Prepended to the record's name field (execution_config.cleanup.prefix_field)
# during runs so created records are identifiable and bulk-deleted after.
# Empty string disables both the prefix and cleanup.
TEST_CLEANUP_PREFIX=[TEST]

# extract.py: agent account used to filter tickets to this tester's own data
TEST_AGENT_EMAIL=

# ── Test accounts ────────────────────────────────────────────────────────────
# execute.py builds ONE {email: password} map from EVERY TEST_*_EMAIL /
# TEST_*_PASSWORD pair below. The prefix label is only for your own reference —
# what matters is that each EMAIL is a real account in the DB.
#
# Two consumers:
#   1. Base persona login — one account per app role. Role → key: upper-case,
#      non-alphanumerics → underscore ("Service Manager" → SERVICE_MANAGER,
#      "any_authorized_role" → AGENT).
#   2. Permission cases ("user has/lacks permission") — NOT wired here. execute
#      reads staff_with_roles from the extracted context and auto-selects an
#      account that HAS or LACKS the module's permission_key, then logs in with
#      its password from this map. Just make sure the pool below contains at
#      least one account that HAS and one that LACKS each permission your
#      scenarios exercise; selection is by DB permissions, not the label.

# -- base roles --
TEST_AGENT_EMAIL=
TEST_AGENT_PASSWORD=

TEST_SERVICE_MANAGER_EMAIL=
TEST_SERVICE_MANAGER_PASSWORD=

TEST_SERVICE_ENGINEER_EMAIL=
TEST_SERVICE_ENGINEER_PASSWORD=

TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

TEST_CUSTOMER_USER_EMAIL=
TEST_CUSTOMER_USER_PASSWORD=

# -- extra staff to span permission states (add as many as you need) --
# Only needed if the base-role accounts above don't already cover both a
# has-permission and a lacks-permission account for a module's permission_key.
# e.g. for service_report.create: one engineer who can create, one who cannot.
TEST_STAFF_1_EMAIL=
TEST_STAFF_1_PASSWORD=
TEST_STAFF_2_EMAIL=
TEST_STAFF_2_PASSWORD=
