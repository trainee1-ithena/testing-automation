# testGen/.env.example — copy to testGen/.env and fill in values
# testGen/.env is gitignored

# ── OpenAI (Stage 2: scenario generation) ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── iSERV URLs ─────────────────────────────────────────────────────────────────
# Frontend React app
FRONTEND_URL=http://localhost:3000
# Backend Express API — must include /api prefix (all routes are mounted under /api)
API_BASE_URL=http://localhost:5000/api

# ── Primary session credentials (Session A) ────────────────────────────────────
# Agent login — used for agent_create_ticket flow and post_creation_visibility
# (can be username OR email; the app accepts both)
TEST_AGENT_EMAIL=
TEST_AGENT_PASSWORD=

# Customer login — used for customer_create_ticket flow
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=

# ── Second session credentials (Session B, multi_session tests only) ────────────
# A DIFFERENT agent account — must be the specific named agent in second_session.
# If left empty, execute.py falls back to TEST_AGENT_EMAIL for Session B.
TEST_SECOND_AGENT_EMAIL=
TEST_SECOND_AGENT_PASSWORD=

# A DIFFERENT customer account — used when second_session.role == "customer".
# If left empty, execute.py falls back to TEST_CUSTOMER_EMAIL for Session B.
TEST_SECOND_CUSTOMER_EMAIL=
TEST_SECOND_CUSTOMER_PASSWORD=

# ── Playwright config (Stage 3 & 4) ───────────────────────────────────────────
# Browser: chromium | firefox | webkit
PLAYWRIGHT_BROWSER=chromium
# Set to false to see the browser window during test runs (useful for debugging)
PLAYWRIGHT_HEADLESS=true
# Timeout for each Playwright assertion in milliseconds
PLAYWRIGHT_TIMEOUT_MS=10000
