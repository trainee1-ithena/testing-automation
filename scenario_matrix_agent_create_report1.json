{
  "flow": "agent_create_report",
  "inventory_text": "A1. report_type | ui_label: Service Report Type | type: select | required: yes | constraints: none | auto_filled: no\nA2. internal_only | ui_label: Internal Only | type: checkbox | required: no | constraints: none | auto_filled: no\nA3. report_form_id | ui_label: Checklist | type: select | required: no | constraints: none | auto_filled: no\nA4. name | ui_label: Service Report Name | type: text | required: yes | constraints: maxLength 256 | auto_filled: yes\nA5. reportDate | ui_label: Service Report Date | type: date | required: yes | constraints: none | auto_filled: no\nA6. ticket_id | ui_label: Case | type: autocomplete | required: yes | constraints: none | auto_filled: yes\nA7. org_id | ui_label: Organization | type: autocomplete | required: yes | constraints: none | auto_filled: yes\nA8. user_id | ui_label: Customer User | type: groupedByCustomer-UserDropdown | required: yes | constraints: none | auto_filled: yes\nA9. appointment_id | ui_label: Appointment | type: autocomplete | required: no | constraints: none | auto_filled: no\nA10. description | ui_label: Description | type: textarea | required: no | constraints: none | auto_filled: no\n\nB2. ticket_id -> report_form_id | EFFECT: filter | GUARD: formOpen | REVERSAL: reset\nB3. ticket_id -> appointment_id | EFFECT: filter | GUARD: none | REVERSAL: reset\nB4. org_id -> user_id | EFFECT: filter | GUARD: none | REVERSAL: reset\nB5. user_id -> org_id | EFFECT: auto-fill | GUARD: none | REVERSAL: none\n\nC1. FIELD: staff_id | CONDITION: {isAgent && (...)} | SHOWN TO: agent | HIDDEN FROM: !agent | TYPE: role_exclusion\n\nD1. agent CAN see the record | WHEN: staff_assigned=agent\nD2. agent CAN see the record | WHEN: staff_accountable=agent\nD3. agent CAN see the record | WHEN: created_by_staff_id=agent\nD4. agent CAN see the record | WHEN: ticket_collaborators includes agent\nD5. agent CAN see the record | WHEN: dept_id in userDepartments\n\nE1. FIELD: report_type | SOURCE: static_enum | DISPLAY LABEL: Fixed Fee & Materials, Time & Material\nE2. FIELD: report_form_id | SOURCE: known_entities.report_forms | DISPLAY LABEL: name | SCOPE: current_user_dept\nE3. FIELD: ticket_id | SOURCE: known_entities.tickets | DISPLAY LABEL: ticket_number - ticket_subject | SCOPE: current_user_dept\nE4. FIELD: org_id | SOURCE: known_entities.customers | DISPLAY LABEL: name\nE5. FIELD: user_id | SOURCE: known_entities.customers[*].users | DISPLAY LABEL: name | CONSTRAINT: org_id and user_id must share the same parent entity\nE6. FIELD: appointment_id | SOURCE: known_entities.tickets[*].appointments | DISPLAY LABEL: title: start_datetime - end_datetime | SCOPE: current_user_dept\n\nF1. FIELD: report_form_id | FILTER: isActive=true\nF2. FIELD: appointment_id | FILTER: state === \"scheduled\" && !service_report\nF3. FIELD: appointment_id | FILTER: !service_report\nF4. FIELD: ticket_id | FILTER: exclude_closed_status=true",
